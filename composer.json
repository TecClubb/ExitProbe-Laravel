{
    "name": "exitprobe/laravel",
    "description": "Official Laravel client for the ExitProbe API — manage projects, monitors, checks, uptime and analytics.",
    "keywords": ["exitprobe", "laravel", "vpn-monitoring", "uptime", "monitoring"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "ExitProbe\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ExitProbe\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ExitProbe\\Laravel\\ExitProbeServiceProvider"
            ],
            "aliases": {
                "ExitProbe": "ExitProbe\\Laravel\\Facades\\ExitProbe"
            }
        }
    },
    "minimum-stability": "stable"
}
